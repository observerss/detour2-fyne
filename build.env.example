# Copy to build.env (gitignored) and fill in. Read at build time by
# tools/gendefaults (via `go generate ./profile/`, run by build.sh and
# scripts/package-cross.sh). Environment variables of the same name win.
# Leave DETOUR2_DEFAULT_PROFILES empty to ship without built-in lines.

# name=address pairs separated by ";" (an address may list several upstreams with ",")
DETOUR2_DEFAULT_PROFILES=hk=tcp://host:port;jp=tcp://host:port
# selected on first launch; must be one of the names above
DETOUR2_DEFAULT_PROFILE=hk
# password shared by the built-in lines
DETOUR2_DEFAULT_PASSWORD=change-me
